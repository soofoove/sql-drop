<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SqlDrop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SqlDrop">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: transparent, so the Mica backdrop shows through like the rest of the window -->
        <Grid x:Name="AppTitleBar" Height="32">
            <TextBlock Text="SqlDrop" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <Grid Grid.Row="1" Padding="12,0,12,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Status bar -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="StatusDot" Width="10" Height="10" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <Button x:Name="SettingsButton" Grid.Column="2" Padding="8,6" Click="SettingsButton_Click"
                    ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
            </Button>
        </Grid>

        <!-- Drop zone / transfer area -->
        <Border x:Name="DropZone" Grid.Row="1" CornerRadius="10" BorderThickness="2" Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop" Tapped="DropZone_Tapped">
            <Grid>
                <!-- Idle -->
                <StackPanel x:Name="IdlePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                    <FontIcon x:Name="IdleIcon" Glyph="&#xE898;" FontSize="40" HorizontalAlignment="Center" />
                    <TextBlock x:Name="IdleText" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Sending / receiving in progress -->
                <StackPanel x:Name="BusyPanel" VerticalAlignment="Center" Spacing="10" Visibility="Collapsed">
                    <TextBlock x:Name="BusyName" FontWeight="SemiBold" TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="BusyProgress" Minimum="0" Maximum="1" />
                    <TextBlock x:Name="BusyText" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="CancelButton" Content="Cancel" HorizontalAlignment="Center"
                            Click="CancelButton_Click" />
                </StackPanel>

                <!-- Incoming file offered -->
                <StackPanel x:Name="IncomingPanel" VerticalAlignment="Center" Spacing="10" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE896;" FontSize="32" HorizontalAlignment="Center" />
                    <TextBlock x:Name="IncomingName" FontWeight="SemiBold" TextAlignment="Center"
                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="IncomingSize" TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                        <Button Content="Accept" Style="{StaticResource AccentButtonStyle}" Click="AcceptButton_Click" />
                        <Button Content="Reject" Click="RejectButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Window>
